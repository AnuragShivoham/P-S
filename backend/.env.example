# ╔══════════════════════════════════════════════════════════════╗
# ║  SOCRATES — Backend Environment Configuration               ║
# ║  Copy this file to .env and fill in your values             ║
# ║  Run: cp .env.example .env                                  ║
# ╚══════════════════════════════════════════════════════════════╝

# ─── Server & CORS ─────────────────────────────────────────────
PORT=3001
# Set this to your deployed Vercel frontend URL (e.g. https://socrates.vercel.app)
FRONTEND_URL=http://localhost:5173
# Additional CORS origins (comma-separated, optional)
ALLOWED_ORIGINS=
# Allow all *.vercel.app preview branches (leave disabled for production unless needed)
ALLOW_VERCEL_PREVIEWS=false

# ─── AI / LLM Provider ────────────────────────────────────────
# Choose: "groq" (cloud, recommended) or "local" (ollama)
LLM_PROVIDER=groq

# Groq API Key (Free at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Local Ollama (only if LLM_PROVIDER=local)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=phi3:mini

# ─── Database ─────────────────────────────────────────────────
# SQLite database path (must be on a persistent disk; Docker image working directory is /app)
DB_PATH=./data/socrates.db
# Optional: set to the persistent workspace mount; Docker defaults to /app/workspace
# WORKSPACE_PATH=/app/workspace

# ─── Authentication ───────────────────────────────────────────
# IMPORTANT: Change this in production! Generate a long random string.
JWT_SECRET=change-this-to-a-random-secret

# Google OAuth Client ID (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Admin Account Configuration
ADMIN_EMAILS=admin@socrates.app
ADMIN_PASSWORD=change_this_admin_password

# ─── Email / OTP ──────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=SOCRATES <no-reply@socrates.app>

# Optional HTTPS fallback used when SMTP is unavailable (for example, Railway outbound SMTP restrictions).
# Create a Resend API key and verify the sender domain before enabling delivery.
RESEND_API_KEY=
RESEND_FROM=SOCRATES <no-reply@your-verified-domain.example>

# ─── Feature Flags ────────────────────────────────────────────
ENABLE_SOCIETAL_PROBLEMS=true
# Demo users, sample employer signals and sample student evidence are off by default; enable only for disposable demos/tests.
ENABLE_DEMO_SEED_DATA=false
# Terminal remains disabled unless explicitly enabled in non-production development; it is not an isolated sandbox.
ENABLE_TERMINAL=false
