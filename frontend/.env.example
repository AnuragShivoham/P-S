# ╔══════════════════════════════════════════════════════════════╗
# ║  SOCRATES — Frontend Environment Configuration             ║
# ║  Copy this file to .env and fill in your values             ║
# ║  Run: cp .env.example .env                                  ║
# ╚══════════════════════════════════════════════════════════════╝

# ─── Backend API & WebSocket URLs ──────────────────────────────
# In local development: leave empty to use Vite's built-in dev proxy to localhost:3001
# Required in production (e.g. Vercel): set to the backend HTTPS origin only (no /api/v1 suffix or trailing slash)
# Example: https://socrates-backend.example.com
VITE_API_URL=

# Optional: WebSocket endpoint override
# If omitted, automatically derived from VITE_API_URL (http -> ws, https -> wss)
# Example: wss://socrates-backend.example.com
VITE_WS_URL=

# ─── Google OAuth ──────────────────────────────────────────────
# Client ID created in Google Cloud Console (https://console.cloud.google.com)
# Must match GOOGLE_CLIENT_ID in the backend
# In Google Console, add your Vercel URL (e.g. https://your-app.vercel.app) to Authorized JavaScript Origins
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
